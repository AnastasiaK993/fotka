DECLARE @день INT = 3;
DECLARE @гостей INT = 10;

SELECT 
    Х.блюдо AS [Заказано],
    CASE
        -- 1. Блюда вообще нет в меню (проверяем таблицу Блюдо)
        WHEN COUNT(Б.[IDблюдо]) = 0 
            THEN '1. Нет в меню'
            
        -- 2. Блюдо есть, но на этот день его не готовят (проверяем День приготовления)
        WHEN COUNT(Д.[IDрецепт]) = 0 
            THEN '2. Не в этот день'
            
        -- 3. Блюдо готовят, но порций меньше, чем гостей
        WHEN ISNULL(SUM(Д.[кол-во порций]), 0) < @гостей 
            THEN '3. Мало порций'
            
        -- 4. Всё отлично
        ELSE '4. Всё есть'
    END AS [Вердикт]
FROM (VALUES 
    ('Суккоташ'), 
    ('Гаспачо'), 
    ('Тирамису')
) AS Х(блюдо)
LEFT JOIN [Блюдо] Б ON Б.[наименование] = Х.блюдо
LEFT JOIN [Рецепт] Р ON Р.[IDблюдо] = Б.[IDблюдо]
LEFT JOIN [День приготовления] Д ON Д.[IDрецепт] = Р.[IDрецепт] AND Д.[день недели] = @день
GROUP BY Х.блюдо;
